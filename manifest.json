{
  "manifest_version": 3,
  "name": "GSC Indexing Tester",
  "version": "1.0.0",
  "description": "Inspect one URL and request indexing in Google Search Console.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["https://search.google.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://search.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
